# Cloudflare applies these to the static assets it serves beside the worker
# (scripts/bundle-worker.mjs copies this file into the web directory). Rules
# that match one path add up and a repeated header is joined with a comma, so
# no path may match two Cache-Control rules.

/__web/*
  X-Robots-Tag: noindex

# Content-tagged: a new build is a new path.
/__web/:tag/mermaid.js
  Cache-Control: public, max-age=31536000, immutable

# Addressed by name: kept a week.
/__web/fonts/*
  Cache-Control: public, max-age=604800, immutable
/favicon.ico
  Cache-Control: public, max-age=604800, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, immutable
/og.png
  Cache-Control: public, max-age=604800, immutable
