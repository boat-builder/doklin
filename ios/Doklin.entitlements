<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A link to a page opens the app straight from doklin.cc: the domain
	     says which app in site/public/.well-known/apple-app-site-association
	     (engine/src/cloud/link.rs PAGE: change all of them). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:doklin.cc</string>
	</array>
</dict>
</plist>
